# Copy to ".env" for local builds with ./scripts/build_dist.sh

# The public address the built store will be served from. It is baked into the
# generated paths, so it has to be the address users will actually reach.
BASE_URL=https://chicohaager.github.io/zima-appstore

# Optional: Docker Hub credentials, only to raise the anonymous pull rate limit
# while the build reads image sizes and digests.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
